# 统一换行符策略
# 默认：交给 git 自动处理
* text=auto

# Shell 脚本必须保持 LF，否则 Linux 上执行报 "bad interpreter: /bin/bash^M"
*.sh text eol=lf

# 容器与配置文件用 LF
Dockerfile text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 环境变量模板用 LF
.env.example text eol=lf
.env.deploy.example text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
