# ============================================================
# 线上部署环境变量模板
# 复制为项目根目录的 .env.deploy 后填写真实值：
#     cp deploy/.env.deploy.example .env.deploy
# 注意：.env.deploy 含密钥，已在 .gitignore 中忽略，切勿提交！
# ============================================================

# ---------- 应用 ----------
APP_NAME=AI 万能视频下载总结器
APP_ENV=production
PORT=8000

# ---------- 数据库 ----------
# 容器内路径，对应 docker-compose 挂载的 ./backend/data
DATABASE_URL=sqlite:////app/data/app.db

# ---------- JWT ----------
# 【必须修改】生产环境请用强随机值，生成方式：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ---------- AI 总结（DeepSeek）----------
# 【必填】https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-你的真实key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- B 站登录态（服务器无浏览器，只能环境变量注入）----------
# 从本地导出 cookies.txt 后，把【整个文件内容】粘贴到下面（用引号包住，换行保留）。
# 或者只填关键三字段（分号分隔），程序会自动转成 Netscape 格式：
#   BILI_COOKIE="SESSDATA=xxx; bili_jct=yyy; DedeUserID=zzz"
# 注意：Cookie 会过期（SESSDATA 通常 30 天），失效后需重新导出并更新此变量。
BILI_COOKIE=

# ---------- 支付开关 ----------
# true  = 关闭支付，AI 总结免登录免付费（演示/内测推荐）
# false = 开启支付，需同时配置下方 Stripe 三项
PAYMENT_DISABLED=true

# ---------- Stripe（PAYMENT_DISABLED=false 时必填）----------
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
FRONTEND_URL=

# ---------- 跨域 ----------
# 前端线上域名，多个用逗号分隔
CORS_ORIGINS=https://your-domain.com
