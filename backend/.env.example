# ============================================================
# 环境变量模板（本地开发）
# 复制为 backend/.env 并填写真实值：cp .env.example .env
# 注意：.env 含密钥，已在 .gitignore 中忽略，切勿提交！
# ============================================================

# ---------- AI 总结 ----------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ---------- JWT ----------
# 生产环境请用强随机值：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=your-jwt-secret-change-in-production

# ---------- B 站登录态（本地可选，线上必填）----------
# 本地：直接跑 python export_cookies_direct.py 生成 cookies.txt 即可，无需此变量
# 线上（微信云托管）：服务器无浏览器，必须用环境变量注入，控制台填【单行分号格式】
#   SESSDATA=xxx; bili_jct=yyy; DedeUserID=123
# 也支持整份 Netscape cookies.txt 内容
BILI_COOKIE=

# ---------- 数据库 ----------
# 本地留空 → 自动使用 SQLite（backend/data/app.db）
# 微信云托管会自动注入 MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD，无需手填
# 仅在内网环境手动指定时才需要下面这行
# MYSQL_ADDRESS=10.0.0.12:3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=saveany

# ---------- 支付功能开关 ----------
# true  = 关闭支付校验，AI 总结等会员功能直接可用（本地测试 / 演示推荐）
# false = 恢复正式校验（需配置下方真实 Stripe 凭证）
PAYMENT_DISABLED=true

# Stripe 支付配置（仅当 PAYMENT_DISABLED=false 时才需要填写）
# 获取地址：https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id

# ---------- 前端 URL（Stripe 支付回跳）----------
FRONTEND_URL=http://localhost:5173

# ---------- 跨域（线上前端域名，多个用逗号分隔）----------
# 前端经 Nginx 反代 /api 时为同源，一般无需配置
CORS_ORIGINS=

# ---------- 服务监听 ----------
# 微信云托管容器内为 80；本地一般用 8000
PORT=8000
